# Opcional: protege /admin y rutas de exportación
ADMIN_TOKEN=pon-aqui-un-token-largo-y-privado

# Puerto de arranque
PORT=3000

# Directorio de datos persistentes (en local puedes dejarlo vacío)
# DATA_DIR=./data

# Fuerza guardar en Google Sheets (si falla, la API devuelve error)
SHEETS_REQUIRED=true

# Google Sheets: ID de la hoja (de la URL de Google Sheets)
GOOGLE_SHEETS_ID=id-de-tu-hoja

# Cuenta de servicio de Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@tu-proyecto.iam.gserviceaccount.com

# Clave privada de la cuenta de servicio (pegar entre comillas, con \n literales)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX...\n-----END PRIVATE KEY-----\n"
